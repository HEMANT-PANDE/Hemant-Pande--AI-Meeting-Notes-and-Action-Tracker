# --- Database (Neon Postgres) ---
# Get this from your Neon project dashboard (use the "pooled connection" string).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.neon.tech/neondb?sslmode=require"

# --- Server ---
PORT=4000
NODE_ENV=development
# Must match the origin the Next.js frontend runs on.
CORS_ORIGIN="http://localhost:3000"

# --- Auth ---
# Generate a long random string, e.g.: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- AI Provider ---
# "anthropic" | "gemini" use a real API. "mock" uses a built-in rule-based
# provider that implements the exact same interface (see src/services/ai) —
# useful for demos or when no API key is available. Never invents data either way.
# Swapping providers is a one-line change here; no code changes needed.
AI_PROVIDER="gemini"

ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxx"
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

GEMINI_API_KEY="xxxxxxxxxxxxxxxx"
GEMINI_MODEL="gemini-flash-latest"
