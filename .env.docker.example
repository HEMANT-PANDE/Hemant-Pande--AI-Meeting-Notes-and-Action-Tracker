# Copy to `.env` (same folder as docker-compose.yml) to override any default.
# docker compose loads a .env file here automatically — this is separate
# from backend/.env and frontend/.env.local, which are only used for
# non-Docker local dev.
#
#   cp .env.docker.example .env
#   docker compose up --build

# --- Local Postgres (the `postgres` service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meeting_tracker
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# "mock" | "anthropic" | "gemini" — "mock" needs no key and still
# demonstrates the full AI flow end to end.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Frontend ---
FRONTEND_PORT=3000
# Must be reachable from the browser, so the mapped host port — not the
# "backend" service name (that only resolves inside the compose network).
NEXT_PUBLIC_API_URL=http://localhost:4000/api
